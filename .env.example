# Copy to .env and fill in only what your area needs. Never commit .env.

# ---- AI layer (packages/ai: CLI, Action, web /review page) ----
SIFT_AI_PROVIDER=gemini                # gemini | openrouter (packages/ai/src/provider.ts); only that file imports a provider SDK
GOOGLE_GENERATIVE_AI_API_KEY=          # gemini: free key from https://aistudio.google.com/apikey
OPENROUTER_API_KEY=                    # openrouter: key from https://openrouter.ai/keys (free models end in ":free")
SIFT_MODEL=gemini-2.5-flash            # main review model, e.g. gemini-2.5-flash or meta-llama/llama-3.3-70b-instruct:free
SIFT_JUDGE_MODEL=                      # cheaper judge model; empty = use SIFT_MODEL
SIFT_FALLBACK_PROVIDER=                # optional: gemini | openrouter; used once if a primary call throws (outage, quota, auth). Empty = no fallback
SIFT_FALLBACK_MODEL=                   # model for the fallback, e.g. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free (needs the fallback provider's key above)

# ---- Pipeline (packages/core, apps/action) ----
SIFT_FEATURES=impact,stack,conventions,feedback   # remove a flag to switch that feature off
SIFT_API_URL=http://localhost:3000     # web app base URL (Vercel URL in production)
SIFT_INGEST_SECRET=                    # shared Bearer secret between the Action and the web app (openssl rand -hex 32)
SIFT_WORKSPACE=                        # path of the target repo checkout (set by the workflow in CI)
GITHUB_TOKEN=                          # local Action runs only: a fine-grained PAT for the demo repo; CI uses the built-in token

# ---- Web app (apps/web) ----
DATABASE_URL=                          # Postgres pooled connection string (runtime)
DIRECT_URL=                            # Postgres direct connection string (prisma migrate)
SIFT_DEMO_PASSCODE=                    # protects /review and /api/review-file
SIFT_GITHUB_TOKEN=                     # read-only GitHub token (fine-grained PAT: Metadata + Pull requests read) so /connect can list repos; Vercel only
SIFT_AUTH_SECRET=                      # accounts (T-45): encrypts GitHub tokens at rest (openssl rand -hex 32). Changing it unlinks every GitHub token
GITHUB_CLIENT_ID=                      # "Continue with GitHub": OAuth App client id (github.com/settings/developers); callback <site>/api/auth/github/callback
GITHUB_CLIENT_SECRET=                  # that OAuth App's client secret
TELEGRAM_BOT_TOKEN=                    # from @BotFather
TELEGRAM_WEBHOOK_SECRET=               # random string; must match setWebhook secret_token
WAIT_HOURS=4                           # PR waiting threshold for Telegram pings and the "impatient" buddy mood
