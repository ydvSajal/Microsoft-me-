# Copy to .env and fill in only what your area needs. Never commit .env.

# ---- AI layer (packages/ai: CLI, Action, web /review page) ----
SIFT_AI_PROVIDER=azure                 # model provider; business logic never imports a provider SDK directly
AZURE_OPENAI_RESOURCE_NAME=            # Azure OpenAI resource name (not the full URL)
AZURE_OPENAI_API_KEY=                  # Azure OpenAI key
SIFT_MODEL=                            # deployment name of the main review model
SIFT_JUDGE_MODEL=                      # deployment name of the cheaper judge model

# ---- Pipeline (packages/core, apps/action) ----
SIFT_FEATURES=impact,stack,conventions,feedback   # remove a flag to switch that feature off
SIFT_API_URL=http://localhost:3000     # web app base URL (Vercel URL in production)
SIFT_INGEST_SECRET=                    # shared Bearer secret between the Action and the web app (openssl rand -hex 32)
SIFT_WORKSPACE=                        # path of the target repo checkout (set by the workflow in CI)
GITHUB_TOKEN=                          # local Action runs only: a fine-grained PAT for the demo repo; CI uses the built-in token

# ---- Web app (apps/web) ----
DATABASE_URL=                          # Postgres pooled connection string (runtime)
DIRECT_URL=                            # Postgres direct connection string (prisma migrate)
SIFT_DEMO_PASSCODE=                    # protects /review and /api/review-file
TELEGRAM_BOT_TOKEN=                    # from @BotFather
TELEGRAM_WEBHOOK_SECRET=               # random string; must match setWebhook secret_token
WAIT_HOURS=4                           # PR waiting threshold for Telegram pings and the "impatient" buddy mood
